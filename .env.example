# ===== Flask =====
FLASK_ENV=development
# 固定值，勿每次启动随机生成，否则重启后登录态全部失效
SECRET_KEY=please-replace-with-python-secrets-token-hex-32
HOST=127.0.0.1
PORT=5001
DEBUG=1

# ===== 数据库 =====
# 方式一：直接给完整 DSN（密码含特殊字符时必须 URL 编码）
# DATABASE_URL=mysql+pymysql://<DB_USER>:<URL编码后的密码>@127.0.0.1:3306/jobtracker?charset=utf8mb4
# 方式二（推荐）：拆开配置，由 config.py 用 quote_plus 自动转义
DB_USER=jt
# 请改成你自己的本地密码，不要提交真实密码到版本库
DB_PASSWORD=please-replace-with-your-db-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jobtracker

# 演示/测试降级通道：注释掉上面 5 行，改用下一行即可切到 SQLite（功能不减）
# DATABASE_URL=sqlite:///instance/jobtracker.db

# ===== 上传 =====
# 纯 ASCII 根目录，规避 Windows 中文路径问题
UPLOAD_ROOT=D:/JobTrackerData/uploads
MAX_UPLOAD_MB=5

# ===== 业务 =====
APP_TIMEZONE=Asia/Shanghai
ITEMS_PER_PAGE=20
# 1 = 使用 app/static/vendor 下的本地 Bootstrap/ECharts（断网演示），0 = CDN
USE_LOCAL_ASSETS=1
